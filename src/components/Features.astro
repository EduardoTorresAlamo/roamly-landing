---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang).features;

// One icon per feature, drawn to match the product: a route, a stack of days,
// a radius around a point.
const icons = ['map', 'days', 'nearby'] as const;
---

<section id="features" class="scroll-mt-24 border-t border-slate-900 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <h2 data-reveal class="text-3xl font-semibold tracking-[-0.02em] sm:text-4xl">
        {copy.title}
      </h2>
      <p data-reveal style="--reveal-delay: 60ms" class="mt-3 text-[17px] text-slate-400">
        {copy.subtitle}
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-3">
      {
        copy.items.map((item, i) => (
          <article
            data-reveal
            style={`--reveal-delay: ${i * 70}ms`}
            class="card card-hover"
          >
            <span class="flex h-10 w-10 items-center justify-center rounded-xl border border-teal-500/25 bg-teal-500/10">
              <svg viewBox="0 0 24 24" class="h-5 w-5 text-teal-400" fill="none" aria-hidden="true">
                {icons[i] === 'map' && (
                  <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 17.5c2.5-.8 4-2.2 7-2.2s5-1 5-3-2.5-2.6-4-1.8" />
                    <circle cx="4" cy="17.5" r="2.2" />
                    <circle cx="17.5" cy="7.5" r="2.2" />
                  </g>
                )}
                {icons[i] === 'days' && (
                  <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3.5" y="5" width="17" height="15" rx="3" />
                    <path d="M3.5 9.5h17M8 3.5v3M16 3.5v3" />
                    <path d="M7.5 13h4M7.5 16.5h7" class="text-amber-400" stroke="currentColor" />
                  </g>
                )}
                {icons[i] === 'nearby' && (
                  <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="2.2" />
                    <path d="M7.8 16.2a6 6 0 0 1 0-8.4M16.2 7.8a6 6 0 0 1 0 8.4" />
                    <path d="M5 19a10 10 0 0 1 0-14M19 5a10 10 0 0 1 0 14" opacity=".45" />
                  </g>
                )}
              </svg>
            </span>

            <h3 class="mt-5 text-lg font-semibold tracking-[-0.01em]">{item.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-slate-400">{item.body}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>

---
import { altPath, languages, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang).nav;
const other: Lang = lang === 'es' ? 'en' : 'es';

const links = [
  { label: copy.features, href: '#features' },
  { label: copy.how, href: '#how' },
  { label: copy.pricing, href: '#pricing' },
];
---

<header
  data-header
  class="fixed inset-x-0 top-0 z-40 border-b border-transparent bg-slate-950/70 backdrop-blur-xl backdrop-saturate-150 transition-colors duration-300 ease-out data-scrolled:border-slate-800/70"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-6">
    <a href={lang === 'es' ? '/' : '/en/'} class="press flex items-center gap-2.5" aria-label="Roamly">
      <svg viewBox="0 0 28 28" class="h-7 w-7" aria-hidden="true">
        <rect width="28" height="28" rx="8" class="fill-teal-500/15 stroke-teal-500/40" stroke-width="1" />
        <path
          d="M8 19.5c0-4 3-4.5 6-4.5s5-1 5-3.5S16.5 8 14.5 9"
          fill="none"
          class="stroke-teal-400"
          stroke-width="1.75"
          stroke-linecap="round"
        />
        <circle cx="8" cy="19.5" r="2" class="fill-teal-400" />
        <circle cx="19.6" cy="9.4" r="2" class="fill-amber-400" />
      </svg>
      <span class="text-[15px] font-semibold tracking-tight text-slate-50">Roamly</span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 md:flex" aria-label={copy.menu}>
      {
        links.map((link) => (
          <a
            href={link.href}
            class="rounded-full px-3 py-2 text-sm text-slate-400 transition-colors duration-150 ease-out hover:text-slate-100"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex items-center gap-3 md:ml-0">
      <a
        href={altPath[lang]}
        hreflang={other}
        aria-label={`${copy.langLabel}: ${languages[other]}`}
        class="press rounded-full border border-slate-800 px-2.5 py-1.5 text-xs font-medium uppercase tracking-wide text-slate-400 transition-colors duration-150 ease-out hover:border-slate-700 hover:text-slate-100"
      >
        {other}
      </a>
      <a href="#pricing" class="btn-primary !px-4 !py-2 text-[13px]">{copy.cta}</a>
    </div>
  </div>
</header>

---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang).pricing;
---

<section id="pricing" class="scroll-mt-24 border-t border-slate-900 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <h2 data-reveal class="text-3xl font-semibold tracking-[-0.02em] sm:text-4xl">{copy.title}</h2>
      <p data-reveal style="--reveal-delay: 60ms" class="mt-3 text-[17px] text-slate-400">
        {copy.subtitle}
      </p>
    </div>

    <div class="mt-12 grid gap-5 md:grid-cols-2">
      {
        copy.plans.map((plan, i) => {
          const featured = i === 1;
          return (
            <article
              data-reveal
              style={`--reveal-delay: ${i * 80}ms`}
              class={`card card-hover relative flex flex-col ${
                featured ? 'border-teal-500/40 bg-slate-900/70' : ''
              }`}
            >
              {featured && (
                <span class="absolute -top-3 right-6 rounded-full bg-amber-400 px-2.5 py-1 text-[11px] font-semibold uppercase tracking-wide text-slate-950">
                  {copy.popular}
                </span>
              )}

              <h3 class="text-sm font-semibold uppercase tracking-wider text-slate-400">
                {plan.name}
              </h3>

              <p class="mt-4 flex items-baseline gap-1">
                <span class="text-5xl font-semibold tracking-[-0.03em] text-slate-50 tabular-nums">
                  {plan.price}
                </span>
                {featured && <span class="text-sm text-slate-500">{copy.perMonth}</span>}
              </p>

              <p class="mt-2 text-[15px] text-slate-400">{plan.tagline}</p>

              <!-- Grows so both CTAs land on the same baseline even though the
                   plans list a different number of features. -->
              <ul class="mt-7 flex-1 space-y-3 border-t border-slate-800/80 pt-7">
                {plan.features.map((feature) => (
                  <li class="flex items-start gap-3 text-[15px] text-slate-300">
                    <svg
                      viewBox="0 0 20 20"
                      class={`mt-0.5 h-4 w-4 shrink-0 ${featured ? 'text-teal-400' : 'text-slate-500'}`}
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="m4.5 10.5 3.5 3.5 7.5-8"
                        stroke="currentColor"
                        stroke-width="1.8"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                    {feature}
                  </li>
                ))}
              </ul>

              <a
                href="#"
                class={`mt-8 w-full ${featured ? 'btn-primary' : 'btn-secondary'}`}
              >
                {plan.cta}
              </a>
            </article>
          );
        })
      }
    </div>

    <p data-reveal class="mt-6 text-xs text-slate-500">{copy.note}</p>
  </div>
</section>

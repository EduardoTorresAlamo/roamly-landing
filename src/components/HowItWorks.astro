---
import { t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const copy = t(lang).how;
---

<section id="how" class="scroll-mt-24 border-t border-slate-900 py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-6">
    <div class="max-w-2xl">
      <h2 data-reveal class="text-3xl font-semibold tracking-[-0.02em] sm:text-4xl">{copy.title}</h2>
      <p data-reveal style="--reveal-delay: 60ms" class="mt-3 text-[17px] text-slate-400">
        {copy.subtitle}
      </p>
    </div>

    <ol class="relative mt-14 grid gap-10 md:grid-cols-3 md:gap-8">
      <!-- The connector is the whole point of numbering these: it says the
           steps are one continuous path, like the route on the map. -->
      <div
        aria-hidden="true"
        class="pointer-events-none absolute left-[1.375rem] top-4 h-[calc(100%-3rem)] w-px bg-gradient-to-b from-teal-500/40 via-slate-800 to-transparent md:left-0 md:top-[1.375rem] md:h-px md:w-full md:bg-gradient-to-r"
      >
      </div>

      {
        copy.steps.map((step, i) => (
          <li data-reveal style={`--reveal-delay: ${i * 80}ms`} class="relative pl-14 md:pl-0">
            <span class="absolute left-0 top-0 flex h-11 w-11 items-center justify-center rounded-full border border-slate-800 bg-slate-950 text-sm font-semibold text-teal-300 md:relative">
              {i + 1}
            </span>
            <h3 class="mt-0 text-lg font-semibold tracking-[-0.01em] md:mt-5">{step.title}</h3>
            <p class="mt-2 max-w-sm text-[15px] leading-relaxed text-slate-400">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
